#!/bin/sh
# Stoicheia's pre-push hook (STOICHEIA_SAFE_PUSH), installed by scripts/install_hooks.sh.
#
# Main changes only by a pull request's merge commit, made on GitHub by
# `python3 scripts/safe_push.py --merge <n>`, so every push to main is refused here,
# however it is spelled (HEAD:main, main, refs/heads/main, --mirror, forced), and so is
# every deletion of main; the ruleset on GitHub enforces the same, and this hook backs it
# up locally. A push to any other branch is scanned for secrets first, with origin/main's
# own copy of the scan (`safe_push.py --scan-push`), so a branch cannot weaken the scan
# that judges it. A tag is pushed or deleted only with the owner's OK, by name:
# STOICHEIA_TAG_PUSH=<tag> git push origin <tag> (docs/WORKFLOW.md, section 1). (The
# owner can still go round it with `git push --no-verify`; the hook is a guard rail, not
# a lock.)
#
# git gives the hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.

remote_name=$1
top=$(git rev-parse --show-toplevel 2>/dev/null)
tmp=
cleanup() { [ -n "$tmp" ] && rm -rf "$tmp"; }
trap cleanup EXIT

# The scan: origin/main's safe_push.py and heath.py, copied out of git; the working
# tree's copy only while origin/main's has no --scan-push.
scan() {
    base=refs/remotes/$remote_name/main
    git rev-parse --verify --quiet "$base" >/dev/null || base=refs/remotes/origin/main
    if [ -z "$tmp" ]; then
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/stoicheia-pre-push.XXXXXX") || return 1
        if git show "$base:scripts/safe_push.py" > "$tmp/safe_push.py" 2>/dev/null &&
                grep -q -e "--scan-push" "$tmp/safe_push.py" &&
                git show "$base:scripts/heath.py" > "$tmp/heath.py" 2>/dev/null; then
            harness=$tmp/safe_push.py
        elif [ -f "$top/scripts/safe_push.py" ]; then
            echo "pre-push: origin/main's safe_push.py has no --scan-push yet; using the" >&2
            echo "    working tree's copy." >&2
            harness=$top/scripts/safe_push.py
        else
            echo "pre-push: no safe_push.py to scan the push with." >&2
            return 1
        fi
    fi
    python3 "$harness" --scan-push "$1" "$2" "$3"
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*)
            tag=${remote_ref#refs/tags/}
            if [ "${STOICHEIA_TAG_PUSH:-}" != "$tag" ]; then
                echo "pre-push: refusing to push or delete the tag $tag on $1: tags and" >&2
                echo "    releases need the owner's OK (docs/WORKFLOW.md, section 1). With it:" >&2
                echo "    STOICHEIA_TAG_PUSH=$tag git push $1 refs/tags/$tag" >&2
                status=1
            fi
            continue
            ;;
        refs/heads/main)
            case "$local_sha" in
                *[!0]*)
                    echo "pre-push: refusing a push to main on $1: main changes only by a pull" >&2
                    echo "    request's merge commit. Push a branch and open one with the pre-flight:" >&2
                    echo "    python3 scripts/safe_push.py --branch <name>" >&2
                    echo "    then merge it with python3 scripts/safe_push.py --merge <pr-number>" >&2
                    echo "    (docs/WORKFLOW.md, \"Landing work: pull requests\")." >&2
                    ;;
                *)
                    echo "pre-push: refusing to delete main on $1." >&2
                    ;;
            esac
            status=1
            continue
            ;;
    esac
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;          # deleting a branch other than main publishes nothing
    esac
    scan "$local_sha" "$remote_sha" "$remote_ref" || status=1
done
exit $status

#!/bin/sh
# Stoicheia's pre-push hook (STOICHEIA_SAFE_PUSH), installed by scripts/install_hooks.sh.
#
# A push to main goes through scripts/safe_push.py, which checks the commit from end to
# end and sets STOICHEIA_SAFE_PUSH to the commit it checked, for its own push alone.
# Any other push to main is refused here, however it is spelled (HEAD:main, main,
# refs/heads/main, --mirror), and so is a push of a commit other than the one checked, a
# push to main that is not a fast-forward (a forced one) even of the commit checked, and
# every deletion of main. A tag is pushed or deleted only with the owner's OK, by name:
# STOICHEIA_TAG_PUSH=<tag> git push origin <tag> (docs/WORKFLOW.md, sections 1 and 10).
# Pushes to other branches pass. (The owner can still go round it with
# `git push --no-verify`; the hook is a guard rail, not a lock.)
#
# git gives the hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*)
            tag=${remote_ref#refs/tags/}
            if [ "${STOICHEIA_TAG_PUSH:-}" != "$tag" ]; then
                echo "pre-push: refusing to push or delete the tag $tag on $1: tags and" >&2
                echo "    releases need the owner's OK (docs/WORKFLOW.md, section 1). With it:" >&2
                echo "    STOICHEIA_TAG_PUSH=$tag git push $1 refs/tags/$tag" >&2
                status=1
            fi
            continue
            ;;
        refs/heads/main) ;;
        *) continue ;;
    esac
    case "$local_sha" in
        *[!0]*) ;;
        *)
            echo "pre-push: refusing to delete main on $1." >&2
            status=1
            continue
            ;;
    esac
    if [ -z "$STOICHEIA_SAFE_PUSH" ]; then
        echo "pre-push: refusing a push to main: push to main only through" >&2
        echo "    python3 scripts/safe_push.py [--commit <sha>] [--dry-run]" >&2
        echo "which checks the commit from end to end (docs/WORKFLOW.md, section 10)." >&2
        status=1
    elif [ "$STOICHEIA_SAFE_PUSH" != "$local_sha" ]; then
        echo "pre-push: refusing a push to main: safe_push.py checked $STOICHEIA_SAFE_PUSH," >&2
        echo "but this push sends $local_sha." >&2
        status=1
    else
        case "$remote_sha" in
            *[!0]*)
                if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                    echo "pre-push: refusing a push to main that is not a fast-forward:" >&2
                    echo "    $1's main is $remote_sha, not an ancestor of $local_sha" >&2
                    echo "    (or not fetched). safe_push.py never forces a push." >&2
                    status=1
                fi
                ;;
        esac
    fi
done
exit $status

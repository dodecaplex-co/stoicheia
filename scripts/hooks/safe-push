#!/bin/sh
# Stoicheia's launcher for the pre-flight (STOICHEIA_SAFE_PUSH_LAUNCHER), installed by
# scripts/install_hooks.sh outside the tracked tree, at
# $(git rev-parse --git-common-dir)/stoicheia/safe-push, and run as `git safe-push`:
#
#     git safe-push --branch <name> [--label L]... [--title T] [--body-file F] [--ready]
#                   [--land] [--commit <sha>] [--dry-run] [--main-checks-cache]
#     git safe-push --merge <pr-number> [--dry-run]
#     git safe-push --dry-run [--commit <sha>] [--main-checks-cache]
#
# It runs origin/main's scripts/safe_push.py whatever the checkout holds, so that a branch
# cannot judge itself, even one whose own copy no longer hands over to origin/main's: it
# fetches origin, copies origin/main's safe_push.py and heath.py out of git into a
# directory named by their blobs (~/.cache/stoicheia/harness/<blob>-<blob>/, beside
# STOICHEIA_PUSH_LOG when that is set), writing each afresh, and execs it with the
# arguments given, so its signals and its exit status are the run's own. The copies are
# read with git's replacement objects off, and safe_push inherits GIT_NO_REPLACE_OBJECTS=1
# and no GIT_REPLACE_REF_BASE (#256): git reads a replacement (refs/replace/, or a ref
# under GIT_REPLACE_REF_BASE) in place of the object it replaces, so one could otherwise
# stand in for origin/main's harness. While origin/main's copy predates running from
# origin/main (no HARNESS_PROTOCOL in it), the checkout's copy runs, and the launcher
# says so.
#
# The interpreter, as the pre-push hook picks it: STOICHEIA_PYTHON if set, else the first
# of python3.14, python3.13, python3.12, python3.11 and python3 that is Python 3.11 or
# later (safe_push reads TOML with tomllib). Without one, it refuses.
set -eu

# No replacement objects for git here, nor for safe_push, which inherits this (#256).
export GIT_NO_REPLACE_OBJECTS=1
# Nor a folder of replacements named in place of refs/replace/.
unset GIT_REPLACE_REF_BASE
# Nor any other variable that ties git to one repository, as `git rev-parse
# --local-env-vars` lists them (safe_push.py's REPOSITORY_VARIABLES): a caller's GIT_DIR,
# GIT_INDEX_FILE and the rest would send this launcher's git to that repository, to fetch
# its origin into it and copy out its origin/main harness. Each git here finds the
# repository by the working directory instead, and so does the safe_push it runs (#359).
# A setting given as `git -c key=value safe-push` no longer reaches the fetch either: set
# it in the repository's configuration.
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_CONFIG GIT_CONFIG_COUNT \
    GIT_CONFIG_PARAMETERS GIT_DIR GIT_GRAFT_FILE GIT_IMPLICIT_WORK_TREE GIT_INDEX_FILE \
    GIT_INTERNAL_SUPER_PREFIX GIT_OBJECT_DIRECTORY GIT_PREFIX GIT_SHALLOW_FILE \
    GIT_WORK_TREE
# Git from 2.19 to 2.41 lets core.useReplaceRefs=true in config override the variable, and
# reads configuration given on its command line last: so each git call here sets it false
# there (safe_push.py does the same for its own git commands).
git() { command git -c core.useReplaceRefs=false "$@"; }

# The interpreter (the pre-push hook, scripts/hooks/pre-push, picks it the same way).
find_python() {
    if [ -n "${STOICHEIA_PYTHON:-}" ]; then
        echo "$STOICHEIA_PYTHON"
        return 0
    fi
    for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
        if command -v "$candidate" >/dev/null 2>&1 &&
                "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' \
                    >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

if ! python=$(find_python); then
    echo "safe-push: no Python 3.11 or later found (python3.14, python3.13, python3.12," >&2
    echo "    python3.11 or python3); name one in STOICHEIA_PYTHON." >&2
    exit 1
fi
top=$(git rev-parse --show-toplevel)
git fetch --quiet origin
base=refs/remotes/origin/main
own=$(git rev-parse --verify --quiet "$base:scripts/safe_push.py" || true)
own_heath=$(git rev-parse --verify --quiet "$base:scripts/heath.py" || true)
if [ -n "$own" ] && [ -n "$own_heath" ] &&
        git cat-file blob "$own" | grep -q HARNESS_PROTOCOL; then
    if [ -n "${STOICHEIA_PUSH_LOG:-}" ]; then
        cache=$(dirname "$STOICHEIA_PUSH_LOG")
    else
        cache=$HOME/.cache/stoicheia
    fi
    dir=$cache/harness/$own-$own_heath
    mkdir -p "$dir"
    git cat-file blob "$own" > "$dir/.safe_push.py.$$"
    mv -f "$dir/.safe_push.py.$$" "$dir/safe_push.py"
    git cat-file blob "$own_heath" > "$dir/.heath.py.$$"
    mv -f "$dir/.heath.py.$$" "$dir/heath.py"
    exec "$python" "$dir/safe_push.py" "$@"
fi
echo "safe-push: origin/main's scripts/safe_push.py does not yet run from origin/main;" >&2
echo "    running the checkout's copy, $top/scripts/safe_push.py." >&2
exec "$python" "$top/scripts/safe_push.py" "$@"
